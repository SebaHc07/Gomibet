<div class="reading-progress" aria-hidden="true"><span></span></div>
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const media = gsap.matchMedia();
  let disposed = false;
  const context = gsap.context(() => {
    gsap.to('.reading-progress span', {
      scaleX: 1, ease: 'none',
      scrollTrigger: { trigger: document.documentElement, start: 0, end: 'max', scrub: true },
    });

  });

  media.add('(prefers-reduced-motion: no-preference)', () => {
    // The server-rendered content stays visible if JavaScript is unavailable.
    // Deep links skip the intro so the destination is immediately readable.
    if (document.querySelector('.hero-title-line') && (!location.hash || location.hash === '#inicio')) {
      gsap.timeline({ defaults: { ease: 'power3.out', duration: 0.9 } })
        .from('.hero-title-line', { yPercent: 105, stagger: 0.13, clearProps: 'transform' })
        .from('.hero-copy .eyebrow, .hero-description, .hero-actions, .hero-proof', { y: 18, opacity: 0, stagger: 0.09, clearProps: 'all' }, 0.2)
        .from('.product-visual', { y: 18, opacity: 0, clearProps: 'transform,opacity' }, 0.15);
    }
    gsap.utils.toArray<HTMLElement>('[data-gallery-frame]').forEach(frame => {
      if (frame.getBoundingClientRect().top < window.innerHeight * 0.9) return;
      gsap.from(frame, {
        y: 20, opacity: 0,
        duration: 0.95, ease: 'power3.out', clearProps: 'transform,opacity',
        scrollTrigger: { trigger: frame, start: 'top 92%', once: true },
      });
    });
    gsap.utils.toArray<HTMLElement>('[data-reveal]').forEach(element => {
      // Never hide content already reached through an anchor or scroll restoration.
      if (element.getBoundingClientRect().top < window.innerHeight * 0.9) return;
      gsap.from(element, {
        y: 32, opacity: 0, duration: 0.85, ease: 'power3.out', clearProps: 'transform,opacity',
        scrollTrigger: { trigger: element, start: 'top 94%', once: true },
      });
    });
  });

  const refresh = () => { if (!disposed) ScrollTrigger.refresh(); };
  document.fonts.ready.then(refresh);
  window.addEventListener('load', refresh, { once: true });
  import.meta.hot?.dispose(() => {
    disposed = true;
    window.removeEventListener('load', refresh);
    media.revert();
    context.revert();
  });
</script>
