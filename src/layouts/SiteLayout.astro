---
import Layout from './Layout.astro';
import BrandIntro from '../components/ui/BrandIntro.astro';
import Navigation from '../components/ui/Navigation.astro';
import SiteFooter from '../components/ui/SiteFooter.astro';
import MotionEnhancements from '../components/ui/MotionEnhancements.astro';
interface Props { title: string; description: string; home?: boolean; }
const { title, description, home = false } = Astro.props;
---
<Layout title={title} description={description} preloadHero={home}>
  <BrandIntro />
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <Navigation />
  <MotionEnhancements />
  <main id="contenido" tabindex="-1"><slot /></main>
  <SiteFooter />
</Layout>
