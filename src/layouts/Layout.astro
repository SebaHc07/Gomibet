---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es" class="bg-black text-white">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Nutrición Intervencional - Gomitas fortificadas con hierro y vitamina C" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
	</head>
	<body class="bg-black antialiased overflow-x-hidden selection:bg-white/20 selection:text-white">
		<slot />
	</body>
</html>
